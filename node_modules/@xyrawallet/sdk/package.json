{
  "name": "@xyrawallet/sdk",
  "version": "0.1.4",
  "description": "Official JavaScript/TypeScript SDK for Xyra wallet integration",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "xyra",
    "xrpl",
    "xahau",
    "wallet",
    "sdk",
    "blockchain"
  ],
  "author": "Xyra",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "20.19.27",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PuppyGamingDev/XyraWallet.git",
    "directory": "packages/sdk"
  }
}
